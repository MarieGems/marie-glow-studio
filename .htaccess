# BEGIN Marie Glow Studio site rules (hand-written; kept above the generated blog redirect block)
ErrorDocument 404 /404.html
DirectoryIndex index.html
Options -MultiViews
# BEGIN turnstile-secret guard: never serve the Turnstile secret key file, even if it is placed here by mistake
<FilesMatch "^turnstile-secret.*$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
# END turnstile-secret guard
<IfModule mod_rewrite.c>
RewriteEngine On

# 0. Never redirect SSL domain-validation files (AutoSSL / Let's Encrypt / Sectigo read /.well-known/ on every host
#    name, and a redirect makes the www certificate check fail).
RewriteRule ^\.well-known/ - [L]

# 1. Old and alternate hosts go to the canonical domain, same path (the old-URL rules below then finish the job).
#    Park or alias lavenderpinco.com and pinaudit.marieharvey.com onto this docroot in cPanel for this to apply.
RewriteCond %{HTTP_HOST} ^(www\.marieglowstudio\.com|(www\.)?lavenderpinco\.com|pinaudit\.marieharvey\.com)$ [NC]
RewriteRule ^(.*)$ https://marieglowstudio.com/$1 [R=301,L]

# 2. HTTPS only.
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^(.*)$ https://marieglowstudio.com/$1 [R=301,L]

# 3. Renamed pages.
RewriteRule ^complete-package(\.html)?/?$ /complete-website-package [R=301,L,NC]
RewriteRule ^meet-me/?$ /about [R=301,L,NC]
# Client billing: a clean address for the Stripe customer portal login (302 so the target can change later)
RewriteRule ^(billing|manage-subscription)/?$ https://billing.stripe.com/p/login/dRm9AU9OO2Lm7x60QG3VC00 [R=302,L,NC]

# 4. Old Shopify store URLs from lavenderpinco.com, each to its closest new page (never blanket to the homepage).
RewriteRule ^collections/shopify-web-design-services/?$ /web-design? [R=301,L,NC]
RewriteRule ^collections/pinterest-marketing-services/?$ /pinterest-marketing? [R=301,L,NC]
RewriteRule ^collections(/.*)?$ /services? [R=301,L,NC]
RewriteRule ^(collections/[^/]+/)?products/pinterest-seo-audit/?$ /pinterest-audit? [R=301,L,NC]
RewriteRule ^(collections/[^/]+/)?products/pinterest-business-account-setup-seo[^/]*/?$ /pinterest-account-setup? [R=301,L,NC]
RewriteRule ^(collections/[^/]+/)?products/monthly-pinterest-management[^/]*/?$ /pinterest-management? [R=301,L,NC]
RewriteRule ^(collections/[^/]+/)?products/complete-shopify-website[^/]*/?$ /complete-website-package? [R=301,L,NC]
RewriteRule ^(collections/[^/]+/)?products/website-starter[^/]*/?$ /website-starter? [R=301,L,NC]
RewriteRule ^products(/.*)?$ /services? [R=301,L,NC]
RewriteRule ^pages/about[^/]*/?$ /about? [R=301,L,NC]
RewriteRule ^pages/portfolio[^/]*/?$ /portfolio? [R=301,L,NC]
RewriteRule ^pages/contact[^/]*/?$ /contact? [R=301,L,NC]
RewriteRule ^pages/[^/]*faq[^/]*/?$ /faqs? [R=301,L,NC]
RewriteRule ^pages(/.*)?$ /? [R=301,L,NC]
RewriteRule ^policies/privacy-policy/?$ /privacy-policy? [R=301,L,NC]
RewriteRule ^policies(/.*)?$ /terms-of-service? [R=301,L,NC]
RewriteRule ^cart/?$ /services? [R=301,L,NC]
RewriteRule ^search/?$ /? [R=301,L,NC]

# 5. Public URLs are extensionless: a request for x.html or index.html 301s to the clean URL.
RewriteCond %{THE_REQUEST} \s/+((?:[^\s?]*/)?)index\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L,NE]
RewriteCond %{THE_REQUEST} \s/+([^\s?]+?)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L,NE]

# 6. Serve the clean URL from its .html file.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+?)/?$ /$1.html [L]
</IfModule>
# END Marie Glow Studio site rules

# BEGIN marie-glow-studio-blog redirects (generated by marie-glow-studio-blog/scripts/build-redirects.mjs, do not edit between the markers)
